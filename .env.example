# Local defaults are safe for development. Never commit real tokens.
WORKER_HOST=127.0.0.1
WORKER_PORT=8080
WORKER_DB_PATH=worker/data/ledger.sqlite3
# Maximum request body size in bytes; allowed range is 1 to 16777216.
WORKER_MAX_BODY_BYTES=1048576
# Required when WORKER_HOST is not loopback.
WORKER_API_TOKEN=
